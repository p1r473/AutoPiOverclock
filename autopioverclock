#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

APO_SOURCE=${BASH_SOURCE[0]}
while [[ -L $APO_SOURCE ]]; do
    APO_SOURCE_DIRECTORY=$(cd -- "$(dirname -- "$APO_SOURCE")" && pwd -P)
    APO_SOURCE_LINK=$(readlink -- "$APO_SOURCE")
    if [[ $APO_SOURCE_LINK == /* ]]; then APO_SOURCE=$APO_SOURCE_LINK
    else APO_SOURCE=${APO_SOURCE_DIRECTORY}/${APO_SOURCE_LINK}; fi
done
APO_ROOT=$(cd -- "$(dirname -- "$APO_SOURCE")" && pwd -P)
export APO_ROOT
unset APO_SOURCE APO_SOURCE_DIRECTORY APO_SOURCE_LINK

# shellcheck source=lib/common.sh
source "${APO_ROOT}/lib/common.sh"
# shellcheck source=lib/config.sh
source "${APO_ROOT}/lib/config.sh"
# shellcheck source=lib/state.sh
source "${APO_ROOT}/lib/state.sh"
# shellcheck source=lib/logging.sh
source "${APO_ROOT}/lib/logging.sh"
# shellcheck source=lib/progress.sh
source "${APO_ROOT}/lib/progress.sh"
# shellcheck source=lib/ssh.sh
source "${APO_ROOT}/lib/ssh.sh"
# shellcheck source=lib/classify.sh
source "${APO_ROOT}/lib/classify.sh"
# shellcheck source=lib/health.sh
source "${APO_ROOT}/lib/health.sh"
# shellcheck source=lib/detect.sh
source "${APO_ROOT}/lib/detect.sh"
# shellcheck source=lib/recovery.sh
source "${APO_ROOT}/lib/recovery.sh"
# shellcheck source=lib/reset.sh
source "${APO_ROOT}/lib/reset.sh"
# shellcheck source=lib/candidates.sh
source "${APO_ROOT}/lib/candidates.sh"
# shellcheck source=lib/apply.sh
source "${APO_ROOT}/lib/apply.sh"
# shellcheck source=lib/report.sh
source "${APO_ROOT}/lib/report.sh"

APO_COMMAND=run
APO_ORIGIN_COMMAND=run
APO_PUBLIC_COMMAND=''
APO_AUTO_APPLY=0
APO_AUTO_PREPARE=0
APO_CONFIG_FILE=''
APO_CONFIG_OPTION_SEEN=0
APO_MODE_REQUESTED=auto
APO_MODE_OPTION_SEEN=0
APO_OUTPUT_DIR="${HOME}/overclock-results"
APO_SSH_PORT=22
APO_IDENTITY_FILE=''
APO_SELECTED_RUN_ID=''
APO_RUN_ID_OPTION_SEEN=0
APO_INSTALL_MISSING=0
APO_REPAIR_WATCHDOGS=0
APO_DRY_RUN=0
APO_ASSUME_YES=0
APO_EDGE_CPU_24H=0
APO_MAX_FAN=1
APO_MAX_FAN_OPTION_SEEN=0
APO_REDACT=0
APO_HAVE_REMOTE_CONTEXT=0
APO_MUTATING_COMMAND=0
APO_LOCK_FD=''
APO_POST_FLOOR_EDGE_SOURCE_STATE=''
APO_POST_FLOOR_EDGE_MAX_FAN=1
APO_WORKER_BOOT_ID=''
APO_REBOOT_BOOT_ID=''
APO_REBOOT_HANDSHAKE_STAGE=''
APO_MANUAL_TEST=0
APO_MANUAL_CPU=''
APO_MANUAL_GPU=''
APO_MANUAL_MINUTES=''
APO_MANUAL_DURATION_S=''
APO_MANUAL_OPTION_SEEN=0
APO_MANUAL_CPU_OPTION_SEEN=0
APO_MANUAL_GPU_OPTION_SEEN=0
APO_MANUAL_MINUTES_OPTION_SEEN=0

usage() {
    cat <<'USAGE'
AutoPiOverclock — recoverable Raspberry Pi 5 overclock validation

Usage:
  autopioverclock prepare TARGET
  autopioverclock overclock TARGET [--edge-cpu-24h] [--no-max-fan]
  autopioverclock test TARGET --cpu MHZ --gpu MHZ --minutes MINUTES [--no-max-fan]
  autopioverclock reset TARGET
  autopioverclock run TARGET [OPTIONS]
  autopioverclock resume TARGET [--run-id RUN_ID]
  autopioverclock status TARGET [--run-id RUN_ID] [--redact]
  autopioverclock recover TARGET [--run-id RUN_ID]
  autopioverclock apply TARGET [--run-id RUN_ID]
  autopioverclock report TARGET [--run-id RUN_ID] [--redact]
  autopioverclock TARGET reset

Commands:
  prepare    Install and verify required dependencies and watchdog recovery
  overclock  Automatically tune, validate, and apply the safe result
  test       Stability-test one exact CPU/GPU pair, then return to normal clocks
  reset      Back up the boot config, remove tuning, reboot, and verify stock clocks
  run        Advanced tuning run with explicit plan/control options
  resume     Recover when needed and continue a selected saved run
  status     Show local state for a selected or latest run
  recover    Return a selected run to verified permanent normal configuration
  apply      Apply a selected fully validated result with typed confirmation
  report     Generate a concise report for a selected or latest run

The optional --edge-cpu-24h flag adds the final CPU +25 MHz/24-hour test.

Target:
  hostname | IP | username@hostname | username@IP
  Without username@, the current controller username from `id -un` is used.
  TARGET is required for every operational command.

Common options:
  --edge-cpu-24h           Add the final CPU +25 MHz/24-hour test to overclock
  --no-max-fan             Do not request maximum Pi PWM fan cooling during tuning/test
  --cpu MHZ                Exact CPU clock for test TARGET
  --gpu MHZ                Exact GPU/V3D clock for test TARGET
  --minutes MINUTES        Timed stress duration for test TARGET (1-1440)
  --output-dir DIR         Flat artifact directory (default: $HOME/overclock-results)
  --ssh-port PORT          SSH port (default: 22)
  --identity-file FILE     SSH private key; otherwise use agent/default keys
  --help                   Show help
  --version                Show version

Advanced options:
  --config FILE            Strict tuning plan for run
  --mode MODE              auto, graphical, or headless for run
  --install-missing        Permit run to install missing workload dependencies
  --repair-watchdogs       Permit run to repair a planned watchdog deficiency
  --dry-run                Read-only discovery and plan generation
  --run-id RUN_ID          Select a retained run for saved-run commands
  --yes                    Skip the ordinary run confirmation; never apply confirmation
  --redact                 Redact status or report output

See docs/cli.md for exact option/command compatibility and safety gates.
USAGE
}

apo_parse_cli() {
    local -a arguments=("$@")
    local index=0 token target=''
    (( ${#arguments[@]} > 0 )) || { usage >&2; exit "$APO_EXIT_USAGE"; }
    case ${arguments[0]} in
        prepare)
            APO_COMMAND=prepare
            APO_ORIGIN_COMMAND=prepare
            APO_PUBLIC_COMMAND=prepare
            APO_AUTO_PREPARE=1
            index=1
            ;;
        overclock)
            APO_COMMAND=run
            APO_ORIGIN_COMMAND=overclock
            APO_PUBLIC_COMMAND=overclock
            APO_AUTO_APPLY=1
            index=1
            ;;
        test)
            APO_COMMAND=run
            APO_ORIGIN_COMMAND=test
            APO_PUBLIC_COMMAND=test
            APO_MANUAL_TEST=1
            index=1
            ;;
        reset)
            APO_COMMAND=reset
            APO_ORIGIN_COMMAND=reset
            APO_PUBLIC_COMMAND=reset
            index=1
            ;;
        run|resume|status|recover|apply|report)
            APO_COMMAND=${arguments[0]}
            APO_ORIGIN_COMMAND=${arguments[0]}
            index=1
            ;;
        --help) usage; exit 0 ;;
        --version) printf '%s\n' "$APO_VERSION"; exit 0 ;;
        *)
            if (( ${#arguments[@]} >= 2 )) && [[ ${arguments[0]} != -* && ${arguments[1]} == reset ]]; then
                APO_COMMAND=reset
                APO_ORIGIN_COMMAND=reset
                target=${arguments[0]}
                index=2
            else
                APO_COMMAND=run
                APO_ORIGIN_COMMAND=run
            fi
            ;;
    esac
    while (( index < ${#arguments[@]} )); do
        token=${arguments[$index]}
        case $token in
            --config|--mode|--output-dir|--ssh-port|--identity-file|--run-id|--cpu|--gpu|--minutes)
                (( index + 1 < ${#arguments[@]} )) || apo_die "$token requires a value." "$APO_EXIT_USAGE"
                case $token in
                    --config) APO_CONFIG_FILE=${arguments[$((index + 1))]}; APO_CONFIG_OPTION_SEEN=1 ;;
                    --mode) APO_MODE_REQUESTED=${arguments[$((index + 1))]}; APO_MODE_OPTION_SEEN=1 ;;
                    --output-dir) APO_OUTPUT_DIR=${arguments[$((index + 1))]} ;;
                    --ssh-port) APO_SSH_PORT=${arguments[$((index + 1))]} ;;
                    --identity-file) APO_IDENTITY_FILE=${arguments[$((index + 1))]} ;;
                    --run-id) APO_SELECTED_RUN_ID=${arguments[$((index + 1))]}; APO_RUN_ID_OPTION_SEEN=1 ;;
                    --cpu)
                        (( APO_MANUAL_CPU_OPTION_SEEN == 0 )) || apo_die '--cpu may be specified only once.' "$APO_EXIT_USAGE"
                        APO_MANUAL_CPU=${arguments[$((index + 1))]}
                        APO_MANUAL_CPU_OPTION_SEEN=1
                        APO_MANUAL_OPTION_SEEN=1
                        ;;
                    --gpu)
                        (( APO_MANUAL_GPU_OPTION_SEEN == 0 )) || apo_die '--gpu may be specified only once.' "$APO_EXIT_USAGE"
                        APO_MANUAL_GPU=${arguments[$((index + 1))]}
                        APO_MANUAL_GPU_OPTION_SEEN=1
                        APO_MANUAL_OPTION_SEEN=1
                        ;;
                    --minutes)
                        (( APO_MANUAL_MINUTES_OPTION_SEEN == 0 )) || apo_die '--minutes may be specified only once.' "$APO_EXIT_USAGE"
                        APO_MANUAL_MINUTES=${arguments[$((index + 1))]}
                        APO_MANUAL_MINUTES_OPTION_SEEN=1
                        APO_MANUAL_OPTION_SEEN=1
                        ;;
                esac
                index=$((index + 2))
                ;;
            --install-missing) APO_INSTALL_MISSING=1; index=$((index + 1)) ;;
            --repair-watchdogs) APO_REPAIR_WATCHDOGS=1; index=$((index + 1)) ;;
            --dry-run) APO_DRY_RUN=1; index=$((index + 1)) ;;
            --edge-cpu-24h) APO_EDGE_CPU_24H=1; index=$((index + 1)) ;;
            --no-max-fan) APO_MAX_FAN=0; APO_MAX_FAN_OPTION_SEEN=1; index=$((index + 1)) ;;
            --yes) APO_ASSUME_YES=1; index=$((index + 1)) ;;
            --redact) APO_REDACT=1; index=$((index + 1)) ;;
            --help) usage; exit 0 ;;
            --version) printf '%s\n' "$APO_VERSION"; exit 0 ;;
            --*) apo_die "Unknown option: $token" "$APO_EXIT_USAGE" ;;
            *) [[ -z $target ]] || apo_die "Unexpected extra argument: $token" "$APO_EXIT_USAGE"; target=$token; index=$((index + 1)) ;;
        esac
    done
    [[ -n $target ]] || apo_die 'TARGET is required for every operational command.' "$APO_EXIT_USAGE"
    case $APO_MODE_REQUESTED in auto|graphical|headless) ;; *) apo_die '--mode must be auto, graphical, or headless.' "$APO_EXIT_USAGE" ;; esac
    apo_validate_uint_range "$APO_SSH_PORT" 1 65535 || apo_die '--ssh-port must be 1-65535.' "$APO_EXIT_USAGE"
    [[ -z $APO_SELECTED_RUN_ID ]] || apo_is_safe_run_id "$APO_SELECTED_RUN_ID" || apo_die 'Invalid --run-id.' "$APO_EXIT_USAGE"
    [[ -z $APO_IDENTITY_FILE || -r $APO_IDENTITY_FILE ]] || apo_die "Identity file is unreadable: $APO_IDENTITY_FILE" "$APO_EXIT_USAGE"
    if [[ $APO_PUBLIC_COMMAND == test ]]; then
        (( APO_MANUAL_CPU_OPTION_SEEN == 1 && APO_MANUAL_GPU_OPTION_SEEN == 1 && APO_MANUAL_MINUTES_OPTION_SEEN == 1 )) ||
            apo_die 'test TARGET requires --cpu MHZ, --gpu MHZ, and --minutes MINUTES.' "$APO_EXIT_USAGE"
        apo_validate_uint_range "$APO_MANUAL_CPU" "$APO_CPU_CLOCK_MIN_MHZ" "$APO_CPU_CLOCK_MAX_MHZ" ||
            apo_die "--cpu must be ${APO_CPU_CLOCK_MIN_MHZ}-${APO_CPU_CLOCK_MAX_MHZ} MHz." "$APO_EXIT_USAGE"
        apo_validate_uint_range "$APO_MANUAL_GPU" "$APO_GPU_CLOCK_MIN_MHZ" "$APO_GPU_CLOCK_MAX_MHZ" ||
            apo_die "--gpu must be ${APO_GPU_CLOCK_MIN_MHZ}-${APO_GPU_CLOCK_MAX_MHZ} MHz." "$APO_EXIT_USAGE"
        apo_validate_uint_range "$APO_MANUAL_MINUTES" 1 1440 || apo_die '--minutes must be 1-1440.' "$APO_EXIT_USAGE"
        APO_MANUAL_DURATION_S=$((APO_MANUAL_MINUTES * 60))
        (( APO_CONFIG_OPTION_SEEN == 0 )) || apo_die 'test TARGET uses its exact --cpu/--gpu/--minutes plan; --config is not valid.' "$APO_EXIT_USAGE"
        (( APO_MODE_OPTION_SEEN == 0 )) || apo_die 'test TARGET chooses graphical or headless mode automatically.' "$APO_EXIT_USAGE"
        (( APO_RUN_ID_OPTION_SEEN == 0 )) || apo_die '--run-id is not valid with test TARGET; repeat the same test command to continue it.' "$APO_EXIT_USAGE"
        (( APO_INSTALL_MISSING == 0 )) || apo_die 'Run prepare TARGET to install dependencies; test does not change host prerequisites.' "$APO_EXIT_USAGE"
        (( APO_REPAIR_WATCHDOGS == 0 )) || apo_die 'Run prepare TARGET to install watchdogs; test does not change host prerequisites.' "$APO_EXIT_USAGE"
        (( APO_DRY_RUN == 0 )) || apo_die '--dry-run is not valid with test TARGET.' "$APO_EXIT_USAGE"
        (( APO_EDGE_CPU_24H == 0 )) || apo_die '--edge-cpu-24h is not valid with test TARGET.' "$APO_EXIT_USAGE"
        (( APO_REDACT == 0 )) || apo_die '--redact is not valid with test TARGET.' "$APO_EXIT_USAGE"
        APO_ASSUME_YES=1
    elif (( APO_MANUAL_OPTION_SEEN == 1 )); then
        apo_die '--cpu, --gpu, and --minutes are valid only with test TARGET.' "$APO_EXIT_USAGE"
    fi
    if [[ $APO_COMMAND == reset ]]; then
        (( APO_CONFIG_OPTION_SEEN == 0 )) || apo_die '--config is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_MODE_OPTION_SEEN == 0 )) || apo_die '--mode is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_RUN_ID_OPTION_SEEN == 0 )) || apo_die '--run-id is not valid with reset TARGET; reset records a new standalone operation.' "$APO_EXIT_USAGE"
        (( APO_INSTALL_MISSING == 0 )) || apo_die '--install-missing is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_REPAIR_WATCHDOGS == 0 )) || apo_die '--repair-watchdogs is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_DRY_RUN == 0 )) || apo_die '--dry-run is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_EDGE_CPU_24H == 0 )) || apo_die '--edge-cpu-24h is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_MAX_FAN_OPTION_SEEN == 0 )) || apo_die '--no-max-fan is not valid with reset TARGET.' "$APO_EXIT_USAGE"
        (( APO_ASSUME_YES == 0 )) || apo_die '--yes is not valid with reset TARGET; reset does not prompt.' "$APO_EXIT_USAGE"
        (( APO_REDACT == 0 )) || apo_die '--redact is not valid with reset TARGET.' "$APO_EXIT_USAGE"
    fi
    if [[ $APO_PUBLIC_COMMAND == prepare ]]; then
        (( APO_CONFIG_OPTION_SEEN == 0 )) || apo_die 'prepare TARGET uses automatic host discovery; custom plans belong to the advanced run command.' "$APO_EXIT_USAGE"
        (( APO_MODE_OPTION_SEEN == 0 )) || apo_die 'prepare TARGET chooses graphical or headless mode automatically.' "$APO_EXIT_USAGE"
        (( APO_RUN_ID_OPTION_SEEN == 0 )) || apo_die '--run-id is not valid with prepare TARGET.' "$APO_EXIT_USAGE"
        (( APO_EDGE_CPU_24H == 0 )) || apo_die '--edge-cpu-24h belongs on overclock TARGET, not prepare TARGET.' "$APO_EXIT_USAGE"
        (( APO_MAX_FAN_OPTION_SEEN == 0 )) || apo_die '--no-max-fan belongs on overclock TARGET, test TARGET, or the advanced run command, not prepare TARGET.' "$APO_EXIT_USAGE"
        (( APO_REDACT == 0 )) || apo_die '--redact is not valid with prepare TARGET.' "$APO_EXIT_USAGE"
        APO_INSTALL_MISSING=1
        APO_REPAIR_WATCHDOGS=1
    fi
    if [[ $APO_PUBLIC_COMMAND == overclock ]]; then
        (( APO_CONFIG_OPTION_SEEN == 0 )) || apo_die 'overclock TARGET is automatic; advanced custom plans use run TARGET --config FILE.' "$APO_EXIT_USAGE"
        (( APO_MODE_OPTION_SEEN == 0 )) || apo_die 'overclock TARGET chooses graphical or headless mode automatically.' "$APO_EXIT_USAGE"
        (( APO_RUN_ID_OPTION_SEEN == 0 )) || apo_die '--run-id is not valid with overclock TARGET.' "$APO_EXIT_USAGE"
        (( APO_INSTALL_MISSING == 0 )) || apo_die 'Run prepare TARGET to install dependencies; overclock does not change host prerequisites.' "$APO_EXIT_USAGE"
        (( APO_REPAIR_WATCHDOGS == 0 )) || apo_die 'Run prepare TARGET to install watchdogs; overclock does not change host prerequisites.' "$APO_EXIT_USAGE"
        (( APO_DRY_RUN == 0 )) || apo_die '--dry-run is not valid with overclock TARGET; use prepare TARGET --dry-run for inspection.' "$APO_EXIT_USAGE"
        (( APO_REDACT == 0 )) || apo_die '--redact is not valid with overclock TARGET.' "$APO_EXIT_USAGE"
        APO_ASSUME_YES=1
    fi
    case $APO_COMMAND in
        run|prepare) ;;
        *)
            (( APO_DRY_RUN == 0 )) || apo_die '--dry-run is valid only with run or prepare; saved-run commands may need recovery writes.' "$APO_EXIT_USAGE"
            [[ -z $APO_CONFIG_FILE ]] || apo_die '--config is valid only with run or prepare; resume uses its recorded plan.' "$APO_EXIT_USAGE"
            [[ $APO_MODE_REQUESTED == auto ]] || apo_die '--mode is valid only with run or prepare; saved runs use their recorded mode.' "$APO_EXIT_USAGE"
            (( APO_INSTALL_MISSING == 0 )) || apo_die '--install-missing is valid only with run or prepare.' "$APO_EXIT_USAGE"
            (( APO_REPAIR_WATCHDOGS == 0 )) || apo_die '--repair-watchdogs is valid only with run or prepare.' "$APO_EXIT_USAGE"
            (( APO_EDGE_CPU_24H == 0 )) || apo_die '--edge-cpu-24h is valid only with a new run or overclock TARGET.' "$APO_EXIT_USAGE"
            (( APO_MAX_FAN_OPTION_SEEN == 0 )) || apo_die '--no-max-fan is valid only with a new run or overclock TARGET.' "$APO_EXIT_USAGE"
            ;;
    esac
    if (( APO_EDGE_CPU_24H == 1 )); then
        [[ $APO_MODE_REQUESTED == auto && -z $APO_CONFIG_FILE ]] ||
            apo_die '--edge-cpu-24h requires configuration-free --mode auto.' "$APO_EXIT_USAGE"
    fi
    case $APO_COMMAND in report|status) ;; *) (( APO_REDACT == 0 )) || apo_die '--redact is valid only with report or status.' "$APO_EXIT_USAGE" ;; esac
    apo_parse_target "$target"
    apo_ssh_init
}

apo_acquire_lock() {
    local lock_file="${APO_OUTPUT_DIR}/.${APO_TARGET_SLUG}.lock"
    apo_safe_mkdir "$APO_OUTPUT_DIR"
    exec {APO_LOCK_FD}>"$lock_file"
    flock -n "$APO_LOCK_FD" || apo_die "Another AutoPiOverclock process holds $lock_file" "$APO_EXIT_PREFLIGHT"
}

apo_public_overclock_select_continuation() {
    local state_file stored_run_id stored_target origin status phase apply_status state_schema saved_edge requested_edge
    local saved_max_fan requested_max_fan requested_max_fan_seen
    local -a state_files=()
    local state_index
    [[ $APO_PUBLIC_COMMAND == overclock ]] || return 0
    requested_edge=$APO_EDGE_CPU_24H
    requested_max_fan=$APO_MAX_FAN
    requested_max_fan_seen=$APO_MAX_FAN_OPTION_SEEN
    state_file=$(apo_find_state_file '' || true)
    [[ -n $state_file ]] || return 0
    apo_state_load "$state_file"
    stored_run_id=$(apo_state_get RUN_ID '')
    stored_target=$(apo_state_get REMOTE_TARGET '')
    origin=$(apo_state_get ORIGIN_COMMAND '')
    status=$(apo_state_get STATUS '')
    phase=$(apo_state_get PHASE '')
    apply_status=$(apo_state_get APPLY_STATUS NOT_APPLIED)
    state_schema=$(apo_state_get RUN_SCHEMA '')
    saved_edge=$(apo_state_get CFG_EDGE_CPU_24H 0)
    saved_max_fan=$(apo_state_get CFG_MAX_FAN 1)
    if apo_is_safe_run_id "$stored_run_id" &&
       [[ $stored_target == "$APO_REMOTE_TARGET" && $origin == overclock ]] &&
       { { [[ $state_schema == "$APO_CURRENT_RUN_SCHEMA" && ( $status == RUNNING || $status == INTERRUPTED ) ]] &&
           [[ $phase != PREPARE && $phase != PREPARED ]]; } ||
         { [[ $state_schema == "$APO_CURRENT_RUN_SCHEMA" && $status == PASS && $phase == COMPLETE ]] &&
           [[ $apply_status == NOT_APPLIED || $apply_status == APPLYING ||
              $apply_status == INTERRUPTED_NO_CHANGE || $apply_status == ROLLED_BACK ]]; } ||
          { [[ $state_schema == "$APO_CURRENT_RUN_SCHEMA" || $state_schema == 7 ]] &&
            apo_final_saved_failure_is_retryable "$state_schema"; }; }; then
        [[ $saved_max_fan == 0 || $saved_max_fan == 1 ]] || apo_die 'The active run has a malformed saved maximum-fan policy.' "$APO_EXIT_INTERNAL"
        if (( requested_max_fan_seen == 1 )) && [[ $requested_max_fan != "$saved_max_fan" ]]; then
            apo_die 'The active run was created with maximum-fan cooling. Its cooling policy cannot change during continuation; reset and start a fresh run to use --no-max-fan.' "$APO_EXIT_USAGE"
        fi
        if (( requested_edge == 1 && saved_edge == 0 )); then
            apo_die 'The active run was created without --edge-cpu-24h. Finish it first, then repeat overclock TARGET --edge-cpu-24h against the applied 8-hour floor.' "$APO_EXIT_USAGE"
        fi
        APO_SELECTED_RUN_ID=$stored_run_id
        APO_COMMAND=resume
        APO_EDGE_CPU_24H=$saved_edge
        APO_MAX_FAN=$saved_max_fan
        return 0
    fi
    if [[ $state_schema == "$APO_CURRENT_RUN_SCHEMA" && $stored_target == "$APO_REMOTE_TARGET" &&
          $origin == overclock && $status == PASS && $phase == COMPLETE && $apply_status == APPLIED ]]; then
        if (( requested_edge == 1 && saved_edge == 0 )); then
            apo_post_floor_edge_source_is_eligible ||
                apo_die 'Later --edge-cpu-24h requires a retained, applied current-schema automatic 8-hour floor with unchanged ownership evidence.' "$APO_EXIT_USAGE"
            state_file="${APO_OUTPUT_DIR}/${APO_TARGET_SLUG}-${stored_run_id}.state"
            [[ -f $state_file ]] || apo_die 'The applied floor selected for later edge validation has no explicit retained state file.' "$APO_EXIT_USAGE"
            apo_state_load "$state_file"
            [[ $(apo_state_get RUN_ID '') == "$stored_run_id" && $(apo_state_get REMOTE_TARGET '') == "$APO_REMOTE_TARGET" ]] &&
                apo_post_floor_edge_source_is_eligible ||
                apo_die 'The explicit retained state for the applied floor failed later-edge eligibility checks.' "$APO_EXIT_USAGE"
            APO_POST_FLOOR_EDGE_SOURCE_STATE=$state_file
            APO_POST_FLOOR_EDGE_MAX_FAN=$requested_max_fan
            APO_COMMAND=post-floor-edge
            APO_EDGE_CPU_24H=1
            return 0
        fi
        APO_SELECTED_RUN_ID=$stored_run_id
        APO_COMMAND=resume
        APO_EDGE_CPU_24H=$saved_edge
        [[ $saved_max_fan == 0 || $saved_max_fan == 1 ]] || apo_die 'The completed run has a malformed saved maximum-fan policy.' "$APO_EXIT_INTERNAL"
        APO_MAX_FAN=$saved_max_fan
        return 0
    fi
    # A later prepare audit may own the latest link even though it left an
    # already-applied floor unchanged. Search retained tuning states only in
    # that benign case; reset or failed tuning state must never be skipped.
    if (( requested_edge == 1 )) && [[ $origin == prepare && $status == PASS && $phase == COMPLETE ]]; then
        shopt -s nullglob
        state_files=("${APO_OUTPUT_DIR}/${APO_TARGET_SLUG}-"*.state)
        shopt -u nullglob
        for ((state_index=${#state_files[@]} - 1; state_index >= 0; state_index--)); do
            state_file=${state_files[$state_index]}
            [[ $state_file != "${APO_OUTPUT_DIR}/${APO_TARGET_SLUG}-latest.state" && -f $state_file ]] || continue
            apo_state_load "$state_file"
            [[ $(apo_state_get REMOTE_TARGET '') == "$APO_REMOTE_TARGET" ]] || continue
            if apo_post_floor_edge_source_is_eligible; then
                APO_POST_FLOOR_EDGE_SOURCE_STATE=$state_file
                APO_POST_FLOOR_EDGE_MAX_FAN=$requested_max_fan
                APO_COMMAND=post-floor-edge
                APO_EDGE_CPU_24H=1
                return 0
            fi
        done
    fi
    APO_STATE=()
    APO_STATE_FILE=''
}

apo_public_test_select_continuation() {
    local state_file stored_run_id stored_target origin status phase state_schema
    local saved_cpu saved_gpu saved_minutes saved_max_fan
    [[ $APO_PUBLIC_COMMAND == test ]] || return 0
    state_file=$(apo_find_state_file '' || true)
    [[ -n $state_file ]] || return 0
    apo_state_load "$state_file"
    stored_run_id=$(apo_state_get RUN_ID '')
    stored_target=$(apo_state_get REMOTE_TARGET '')
    origin=$(apo_state_get ORIGIN_COMMAND '')
    status=$(apo_state_get STATUS '')
    phase=$(apo_state_get PHASE '')
    state_schema=$(apo_state_get RUN_SCHEMA '')
    saved_cpu=$(apo_state_get CFG_MANUAL_CPU "$(apo_state_get MANUAL_CPU '')")
    saved_gpu=$(apo_state_get CFG_MANUAL_GPU "$(apo_state_get MANUAL_GPU '')")
    saved_minutes=$(apo_state_get CFG_MANUAL_MINUTES "$(apo_state_get MANUAL_MINUTES '')")
    saved_max_fan=$(apo_state_get CFG_MAX_FAN 1)
    if apo_is_safe_run_id "$stored_run_id" &&
       [[ $stored_target == "$APO_REMOTE_TARGET" && $origin == test && $state_schema == "$APO_CURRENT_RUN_SCHEMA" ]] &&
       [[ $status == RUNNING || $status == INTERRUPTED ]] &&
       [[ $phase != PREPARE && $phase != PREPARED && $phase != COMPLETE ]]; then
        [[ $saved_cpu == "$APO_MANUAL_CPU" && $saved_gpu == "$APO_MANUAL_GPU" && $saved_minutes == "$APO_MANUAL_MINUTES" ]] ||
            apo_die "An interrupted manual test is retained for CPU=${saved_cpu:-?} GPU=${saved_gpu:-?} duration=${saved_minutes:-?} minutes. Repeat that exact test command, or recover it explicitly before starting different clocks." "$APO_EXIT_USAGE"
        [[ $saved_max_fan == 0 || $saved_max_fan == 1 ]] || apo_die 'The interrupted manual test has a malformed saved maximum-fan policy.' "$APO_EXIT_INTERNAL"
        if (( APO_MAX_FAN_OPTION_SEEN == 1 )) && [[ $APO_MAX_FAN != "$saved_max_fan" ]]; then
            apo_die 'The interrupted manual test cooling policy cannot change during continuation.' "$APO_EXIT_USAGE"
        fi
        APO_SELECTED_RUN_ID=$stored_run_id
        APO_COMMAND=resume
        APO_MAX_FAN=$saved_max_fan
        return 0
    fi
    APO_STATE=()
    APO_STATE_FILE=''
}

