            apo_summary_line "HOST PREPARED: dependencies and watchdog recovery are ready; permanent clocks must be reset before tuning."
            apo_summary_line "Next: autopioverclock reset $APO_RAW_TARGET"
            apo_event prepare PASS '' 'Required dependencies and the watchdog recovery chain are installed and verified. Run reset once before overclocking this currently tuned host.'
        fi
        return 0
    fi
    if (( APO_DRY_RUN == 1 )); then
        apo_state_phase PREPARED READ_ONLY PASS
        apo_summary_line "READ-ONLY PLAN: profile=$APO_PROFILE mode=$APO_MODE_EFFECTIVE normal=${APO_NORMAL_CPU}/${APO_NORMAL_GPU} voltage=${APO_NORMAL_VOLTAGE}"
        apo_event prepare PASS '' 'Read-only discovery and plan generation completed; no target file was written and no reboot was requested.'
        return 0
    fi
    apo_info "Live plan ready: profile=$APO_PROFILE mode=$APO_MODE_EFFECTIVE normal=${APO_NORMAL_CPU}/${APO_NORMAL_GPU}MHz voltage=${APO_NORMAL_VOLTAGE}uV test-voltage=${APO_TEST_VOLTAGE}uV CPU-candidates=${APO_CFG[CPU_CANDIDATES]:-none} GPU-candidates=${APO_CFG[GPU_CANDIDATES]:-none} permanent-hash=$APO_PERMANENT_CONFIG_HASH"
    apo_info "Review the full preflight summary before confirmation: $APO_SUMMARY_FILE"
    apo_confirm_ordinary "Begin the recoverable tuning run against $APO_REMOTE_TARGET?" || { apo_state_phase PREPARED AWAITING_CONFIRMATION INTERRUPTED; apo_warn 'Run was not confirmed.'; return 0; }
    apo_reset_throttle_history run-baseline || { apo_state_fail "$APO_LAST_CLASS" "$APO_LAST_REASON"; return 1; }
    if ! apo_health_check "$APO_NORMAL_CPU" "$APO_NORMAL_GPU" "$APO_NORMAL_VOLTAGE" normal-preflight; then apo_state_fail PREFLIGHT_FAILURE "$APO_LAST_REASON"; return 1; fi
    apo_state_phase TRYBOOT_PROOF READY RUNNING
    apo_run_tuning
}

apo_load_selected_run() {
    local state_file stored_target stored_profile stored_run_id expected_state_file
    state_file=$(apo_find_state_file "$APO_SELECTED_RUN_ID" || true)
    [[ -n $state_file ]] || apo_die "No saved state found for $APO_TARGET_SLUG${APO_SELECTED_RUN_ID:+ run $APO_SELECTED_RUN_ID}." "$APO_EXIT_USAGE"
    apo_state_load "$state_file"
    stored_run_id=$(apo_state_get RUN_ID '')
    apo_is_safe_run_id "$stored_run_id" || apo_die 'Saved state contains an invalid run ID.' "$APO_EXIT_INTERNAL"
    expected_state_file="${APO_OUTPUT_DIR}/${APO_TARGET_SLUG}-${stored_run_id}.state"
    [[ $state_file == "$expected_state_file" ]] || apo_die 'Saved state run ID does not match its selected state filename.' "$APO_EXIT_INTERNAL"
    stored_target=$(apo_state_get REMOTE_TARGET)
    [[ $stored_target == "$APO_REMOTE_TARGET" ]] || apo_die "Selected state belongs to $stored_target, not $APO_REMOTE_TARGET." "$APO_EXIT_USAGE"
    apo_attach_artifacts_from_state
    case $APO_COMMAND in status|report) return 0 ;; esac
    if [[ $(apo_state_get ORIGIN_COMMAND '') == reset ]]; then
        apo_die 'A stock-reset audit cannot be resumed, recovered, or applied as a tuning run. Inspect it with status/report, or run autopioverclock reset TARGET again.' "$APO_EXIT_USAGE"
    fi
    if [[ $APO_COMMAND == apply && $(apo_state_get ORIGIN_COMMAND '') == test ]]; then
        apo_die 'A manual stability test is evidence only and can never be permanently applied. Use overclock TARGET for conservative selection and full validation.' "$APO_EXIT_USAGE"
    fi
    stored_profile=$(apo_state_get PROFILE '')
    if [[ -z $stored_profile ]]; then
        case $APO_COMMAND in
            status|report) return 0 ;;
            *) apo_die 'The saved run was interrupted before target discovery produced a recoverable profile context. Remote mutation is refused; inspect it with status/report and start a new run after confirming a normal boot.' "$APO_EXIT_PREFLIGHT" ;;
        esac
    fi
    apo_restore_context_from_state
    apo_progress_start_session
}

apo_prepare_remote_for_saved_run() {
    apo_ssh_preflight
    apo_deploy_worker
    APO_HAVE_REMOTE_CONTEXT=1
}

apo_cleanup_handler() {
    local exit_code=$? saved_failure_class='' original_failure_class='' original_failure_reason='' recovery_reason=''
    trap - EXIT INT TERM HUP
    if declare -F apo_progress_clear_line >/dev/null 2>&1; then apo_progress_clear_line; fi
    if [[ ${APO_HAVE_REMOTE_CONTEXT:-0} == 1 && ${APO_MUTATING_COMMAND:-0} == 1 ]]; then
        local tryboot_flag=''
        tryboot_flag=$(apo_remote_tryboot_flag || true)
        if [[ $tryboot_flag == 00000001 || $(apo_state_get TRYBOOT_EXPECTED 0) == 1 ||
              $(apo_state_get TRYBOOT_FILE_MAY_EXIST 0) == 1 || -n $(apo_state_get TRYBOOT_OWNED_HASH '') ||
              -n $(apo_state_get TRYBOOT_RESERVATION_HASH '') || -n $(apo_state_get TRYBOOT_OWNERSHIP_TOKEN '') ||
              -n $(apo_state_get TRYBOOT_QUARANTINE_PATH '') ]]; then
            apo_warn_plain 'Controller is exiting while tryboot may be active or staged; verifying normal recovery and owned-file cleanup.'
            if ! apo_recover_normal exit-trap-recovery; then
                recovery_reason=${APO_LAST_REASON:-unknown recovery error}
                original_failure_class=$(apo_state_get FAILURE_CLASS '')
                original_failure_reason=$(apo_state_get FAILURE_REASON '')
                if [[ -n $original_failure_class ]]; then
                    recovery_reason="Original $original_failure_class: ${original_failure_reason:-unspecified}; exit-trap recovery failed: $recovery_reason"
                else
                    recovery_reason="Exit-trap recovery failed: $recovery_reason"
                fi
                APO_LAST_CLASS=RECOVERY_FAILURE
                APO_LAST_REASON=$recovery_reason
                [[ -z ${APO_STATE_FILE:-} || ! -f ${APO_STATE_FILE:-} ]] || apo_state_fail RECOVERY_FAILURE "$recovery_reason" || true
                exit_code=$APO_EXIT_RECOVERY
            fi
        fi
    fi
    if [[ -n ${APO_STATE_FILE:-} && -f ${APO_STATE_FILE:-} && $exit_code -ne 0 ]]; then
        local state_status fatal_class=''
        state_status=$(apo_state_get STATUS '')
        if [[ $state_status == RUNNING || $state_status == PREPARING ]]; then
            fatal_class=$(apo_exit_code_class "${APO_FATAL_EXIT_CODE:-$exit_code}" 2>/dev/null || true)
            if [[ -n $fatal_class && -n ${APO_FATAL_MESSAGE:-} ]]; then
                apo_state_fail "$fatal_class" "$APO_FATAL_MESSAGE" || true
            else
                apo_state_interrupt "Controller exited with code $exit_code." || true
            fi
        fi
        saved_failure_class=$(apo_state_get FAILURE_CLASS '')
        if [[ $exit_code == 1 && -n $saved_failure_class ]]; then exit_code=$(apo_class_exit_code "$saved_failure_class"); fi
    fi
    [[ -n ${APO_JSONL_FILE:-} && -f ${APO_JSONL_FILE:-} ]] && apo_finalize_json || true
    if [[ ${APO_WORKER_DEPLOYED:-0} == 1 && ${APO_HAVE_REMOTE_CONTEXT:-0} == 1 && $(apo_remote_tryboot_flag 2>/dev/null || true) != 00000001 ]]; then apo_profile_cleanup_worker || true; fi
    exit "$exit_code"
}

apo_exit_from_saved_failure() {
    local failure_class
    failure_class=$(apo_state_get FAILURE_CLASS HARNESS_FAILURE)
    return "$(apo_class_exit_code "$failure_class")"
}

main() {
    local status state_schema retry_saved_final=0 saved_failure_stage='' saved_failure_class='' saved_failure_reason=''
    apo_parse_cli "$@"
    apo_require_local_commands ssh awk sed grep date mktemp sha256sum base64 diff cmp flock od tr sync chmod mkdir mv readlink rm
    case $APO_COMMAND in run|prepare|resume|recover|reset|apply) apo_acquire_lock ;; esac
    apo_public_overclock_select_continuation
    apo_public_test_select_continuation
    apo_progress_start_session
    trap apo_cleanup_handler EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    case $APO_COMMAND in
        run|prepare)
            APO_MUTATING_COMMAND=$([[ $APO_DRY_RUN == 0 ]] && printf 1 || printf 0)
            apo_start_new_run
            apo_finish_public_overclock
            ;;
        post-floor-edge)
            APO_MUTATING_COMMAND=1
            apo_start_post_floor_edge
            apo_finish_public_overclock
            ;;
        reset)
            # Stock reset has its own idempotent worker/reboot protocol. The
            # generic tuning exit trap must not interpret reset state as owned
            # tryboot candidate state.
            APO_MUTATING_COMMAND=0
            apo_reset_stock
            ;;
        status)
            apo_load_selected_run
            apo_print_status
            ;;
        report)
            apo_load_selected_run
            apo_generate_report
            ;;
        resume)
            APO_MUTATING_COMMAND=1
            apo_load_selected_run
            if [[ $APO_PUBLIC_COMMAND == overclock ]]; then
                apo_event overclock-resume INFO '' "Continuing interrupted overclock run $APO_RUN_ID through the same safety gates."
            fi
            state_schema=$(apo_state_get RUN_SCHEMA '')
            if [[ $state_schema != "$APO_CURRENT_RUN_SCHEMA" ]]; then
                if [[ $state_schema == 7 ]] && apo_final_migrate_legacy_retry_state "$state_schema"; then
                    apo_event overclock-resume INFO '' 'Adopted the recovered final-stress boundary without repeating the failed clock.'
                else
                    apo_die 'This interrupted state predates the current safety/resume schema and cannot be resumed without bypassing required gates. Start a new run; status and report remain available.' "$APO_EXIT_USAGE"
                fi
            fi
            apo_validate_auto_resume_state || return "$APO_EXIT_HARNESS"
            if [[ $(apo_state_get ORIGIN_COMMAND '') == prepare || $(apo_state_get READ_ONLY_RUN 0) == 1 ]]; then
                apo_die 'A read-only prepare/dry-run state cannot be resumed into a mutating tuning run. Start a new run with an approved tuning plan.' "$APO_EXIT_USAGE"
            fi
            if [[ $(apo_state_get PHASE '') == PREPARE ]]; then
                apo_die "This run was interrupted during preflight${APO_STATE[WATCHDOG_REPAIR_STATUS]:+ (watchdog repair status: ${APO_STATE[WATCHDOG_REPAIR_STATUS]}, old hash: ${APO_STATE[WATCHDOG_REPAIR_OLD_HASH]:-missing}, expected hash: ${APO_STATE[WATCHDOG_REPAIR_EXPECTED_HASH]:-missing})}. Resume refuses to adopt any preflight config change as a new baseline; inspect status/report and start a new run after verifying the target's normal boot." "$APO_EXIT_PREFLIGHT"
            fi
            if [[ $(apo_state_get PHASE) == PREPARED && -z $(apo_state_get ORIGIN_COMMAND '') ]]; then
                apo_die 'This legacy PREPARED state does not prove that mutating preflight completed. Start a new run instead of resuming it.' "$APO_EXIT_USAGE"
            fi
            if [[ $(apo_state_get PHASE '') == PREPARED || $(apo_state_get SUBPHASE '') == AWAITING_CONFIRMATION ]]; then
                apo_die 'A run stopped before tuning confirmation cannot be resumed into a mutating run. Start a new run and complete preflight confirmation.' "$APO_EXIT_USAGE"
            fi
            if [[ $(apo_state_get APPLY_STATUS NOT_APPLIED) == APPLYING ]]; then
                if ! apo_wait_for_ssh "$APO_BOOT_TIMEOUT"; then
                    apo_apply_pause 'Interrupted apply remains pending because SSH did not become reachable.' || true
                    return "$APO_EXIT_APPLY"
                fi
                apo_prepare_remote_for_saved_run
                if ! apo_reconcile_interrupted_apply; then return "$APO_EXIT_APPLY"; fi
                if (( APO_AUTO_APPLY == 1 )) && [[ $(apo_state_get APPLY_STATUS '') != APPLIED ]]; then
                    apo_finish_public_overclock
                fi
                apo_print_status
                return 0
            fi
            if [[ $(apo_state_get APPLY_STATUS NOT_APPLIED) == FAILED_NEEDS_MANUAL_RECOVERY ]]; then
                apo_die "This run has an unresolved permanent-config mismatch: $(apo_state_get APPLY_FAILURE_REASON 'manual recovery required')" "$APO_EXIT_APPLY"
            fi
            status=$(apo_state_get STATUS)
            if [[ $status == PASS && $(apo_state_get PHASE) == COMPLETE ]]; then
                if (( APO_AUTO_APPLY == 1 )); then
                    apo_prepare_remote_for_saved_run
                    apo_finish_public_overclock
                fi
                apo_print_status
                return 0
            fi
            if apo_final_saved_failure_is_retryable "$APO_CURRENT_RUN_SCHEMA"; then
                retry_saved_final=1
                saved_failure_stage=$(apo_state_get FINAL_STAGE '')
                saved_failure_class=$(apo_state_get FAILURE_CLASS '')
                saved_failure_reason=$(apo_state_get FAILURE_REASON '')
            fi
            apo_prepare_remote_for_saved_run
            apo_recover_normal resume-initial-recovery || { apo_state_fail RECOVERY_FAILURE "$APO_LAST_REASON"; return "$APO_EXIT_RECOVERY"; }
            if (( retry_saved_final == 1 )); then
                if ! apo_final_schedule_stress_backoff "$saved_failure_stage" "$saved_failure_class" "$saved_failure_reason"; then
                    apo_state_fail "$saved_failure_class" "$saved_failure_reason"
                    return "$(apo_class_exit_code "$saved_failure_class")"
                fi
            else
                apo_state_set STATUS RUNNING
                apo_state_set FAILURE_CLASS ''
                apo_state_set FAILURE_REASON ''
                apo_state_save
            fi
            apo_run_tuning
            apo_finish_public_overclock
            ;;
        recover)
            APO_MUTATING_COMMAND=1
            apo_load_selected_run
            apo_prepare_remote_for_saved_run
            apo_recover_normal explicit-recovery || { apo_state_fail RECOVERY_FAILURE "$APO_LAST_REASON"; return "$APO_EXIT_RECOVERY"; }
            apo_event recover PASS '' 'Target is back in permanent normal config and passed health.'
            ;;
        apply)
            APO_MUTATING_COMMAND=1
            apo_load_selected_run
            apo_validate_auto_resume_state || return "$APO_EXIT_HARNESS"
            if [[ $(apo_state_get APPLY_STATUS NOT_APPLIED) == APPLYING ]] && ! apo_wait_for_ssh "$APO_BOOT_TIMEOUT"; then
                apo_apply_pause 'Interrupted apply remains pending because SSH did not become reachable.' || true
                return "$APO_EXIT_APPLY"
            fi
            apo_prepare_remote_for_saved_run
            apo_apply_recommendation
            ;;
    esac
    return 0
}

if [[ ${APO_CLI_LIBRARY_ONLY:-0} != 1 ]]; then main "$@"; fi
