apo_start_post_floor_edge() {
    local source_state_file=$APO_POST_FLOOR_EDGE_SOURCE_STATE source_run_id source_hash floor_cpu floor_gpu edge_target
    local validation_reason source_mode source_gpu_requirement key cpu_boundary baseline_boot_id
    local -A source_state=()
    [[ -n $source_state_file && -f $source_state_file ]] ||
        apo_die 'The retained production-floor state selected for the 24-hour edge run is unavailable.' "$APO_EXIT_USAGE"
    apo_state_load "$source_state_file"
    [[ $(apo_state_get REMOTE_TARGET '') == "$APO_REMOTE_TARGET" ]] ||
        apo_die 'The retained production-floor state belongs to another target.' "$APO_EXIT_USAGE"
    apo_post_floor_edge_source_is_eligible ||
        apo_die 'The retained run is not an applied current-schema 8-hour automatic floor with clear tryboot ownership.' "$APO_EXIT_USAGE"
    source_run_id=$(apo_state_get RUN_ID '')
    source_hash=$(apo_state_get PERMANENT_HASH '')
    floor_cpu=$(apo_state_get FINAL_CPU '')
    floor_gpu=$(apo_state_get FINAL_GPU '')
    source_mode=$(apo_state_get MODE_EFFECTIVE '')
    source_gpu_requirement=$(apo_state_get REQUIRE_GPU_STRESS '')
    APO_RUN_ID=$source_run_id
    apo_restore_context_from_state
    APO_STATE_VALIDATION_READ_ONLY=1
    if ! apo_validate_auto_resume_state; then
        validation_reason=${APO_LAST_REASON:-'retained state validation failed'}
        APO_STATE_VALIDATION_READ_ONLY=0
        APO_STATE=()
        APO_STATE_FILE=''
        apo_die "The retained 8-hour floor failed read-only safety validation: $validation_reason" "$APO_EXIT_HARNESS"
    fi
    APO_STATE_VALIDATION_READ_ONLY=0
    [[ $APO_MODE_EFFECTIVE == "$source_mode" && $APO_REQUIRE_GPU_STRESS == "$source_gpu_requirement" ]] ||
        apo_die 'The retained graphical/headless validation mode could not be reconstructed exactly.' "$APO_EXIT_HARNESS"
    for key in "${!APO_STATE[@]}"; do source_state["$key"]=${APO_STATE[$key]}; done

    APO_EDGE_CPU_24H=1
    APO_MAX_FAN=$APO_POST_FLOOR_EDGE_MAX_FAN
    edge_target=$((floor_cpu + APO_AUTO_REFINE_STEP_MHZ))
    apo_init_artifacts
    APO_STATE=()
    for key in "${!source_state[@]}"; do APO_STATE["$key"]=${source_state[$key]}; done
    apo_post_floor_edge_reset_child_state "$source_run_id" "$source_hash" "$floor_cpu" "$floor_gpu" "$edge_target"
    apo_progress_start_session
    apo_load_profile "$APO_PROFILE"
    apo_store_artifact_state
    apo_write_effective_config "$APO_EFFECTIVE_CONFIG_FILE"
    {
        printf 'SourceFloorRunID=%s\nSourceFloorState=%s\nSourceFloorPermanentHash=%s\n' \
            "$source_run_id" "$source_state_file" "$source_hash"
        printf 'Profile=%s\nMode=%s\nGPUStressRequired=%s\nFloorCPU=%s\nFloorGPU=%s\nEdgeCPU=%s\n' \
            "$APO_PROFILE" "$APO_MODE_EFFECTIVE" "$APO_REQUIRE_GPU_STRESS" "$floor_cpu" "$floor_gpu" "$edge_target"
    } > "$APO_DISCOVERY_FILE"
    chmod 600 "$APO_DISCOVERY_FILE"
    apo_summary_line "AutoPiOverclock post-floor CPU edge validation"
    apo_summary_line "Run ID: $APO_RUN_ID"
    apo_summary_line "Source 8-hour floor run: $source_run_id"
    apo_summary_line "Target: $APO_REMOTE_TARGET"
    apo_summary_line "Retained mode: $APO_MODE_EFFECTIVE"
    apo_summary_line "Applied production floor: CPU $floor_cpu MHz / GPU $floor_gpu MHz"
    apo_summary_line "24-hour edge target: CPU $edge_target MHz / GPU $floor_gpu MHz"
    apo_summary_line "Maximum fan cooling during tuning: $([[ $APO_MAX_FAN == 1 ]] && printf enabled || printf disabled)"
    apo_summary_line 'The retained 8-hour endurance phase will not be repeated.'
    apo_summary_line ''
    apo_event run-start INFO '' "command=overclock-post-floor-edge version=$APO_VERSION source-run=$source_run_id mode=$APO_MODE_EFFECTIVE"

    apo_validate_auto_resume_state || return "$APO_EXIT_HARNESS"
    apo_prepare_remote_for_saved_run
    if ! apo_apply_assert_tryboot_clear; then
        apo_state_fail RECOVERY_FAILURE "Post-floor edge baseline has uncleared tryboot evidence: $APO_LAST_REASON"
        return "$APO_EXIT_RECOVERY"
    fi
    if ! apo_verify_permanent_hash post-floor-edge-baseline-hash; then
        apo_state_fail RECOVERY_FAILURE "The applied production-floor config no longer matches source run $source_run_id: $APO_LAST_REASON"
        return "$APO_EXIT_RECOVERY"
    fi
    if ! apo_recover_normal post-floor-edge-baseline-health; then
        apo_state_fail RECOVERY_FAILURE "The applied production floor did not pass current normal-health proof: $APO_LAST_REASON"
        return "$APO_EXIT_RECOVERY"
    fi
    baseline_boot_id=$(apo_state_get NORMAL_BOOT_ID '')
    apo_state_set BASELINE_BOOT_ID "$baseline_boot_id"
    apo_state_set SUBPHASE EDGE_CPU_24H_PRE_STRESS_BOOT
    apo_state_save

    cpu_boundary=$(apo_state_get CPU_FAILURE_BOUNDARY '')
    if (( edge_target > APO_AUTO_CPU_MAX_MHZ )) ||
       { [[ -n $cpu_boundary ]] && (( edge_target >= cpu_boundary )); }; then
        apo_state_set EDGE_CPU_STATUS SKIPPED_KNOWN_BOUNDARY
        apo_state_set RECOMMENDED_CPU "$floor_cpu"
        apo_state_set RECOMMENDED_GPU "$floor_gpu"
        apo_state_set FINAL_TARGET_CPU "$floor_cpu"
        apo_state_set FINAL_TARGET_GPU "$floor_gpu"
        apo_state_complete "$floor_cpu" "$floor_gpu" 28800
        apo_summary_line "OPTIONAL EDGE CPU: SKIPPED — ${edge_target} MHz meets or exceeds the retained failure/ceiling boundary; kept the applied production floor."
        apo_event edge-cpu-24h WARN STABILITY_FAILURE "Skipped known unsafe edge CPU target $edge_target MHz; retained applied floor CPU=$floor_cpu GPU=$floor_gpu"
        return 0
    fi
    apo_event post-floor-edge PASS '' "Applied 8-hour floor and headless/graphical mode were re-proved; starting only the CPU +25 MHz/24-hour edge validation."
    apo_final_validation
}

apo_finish_public_overclock() {
    (( APO_AUTO_APPLY == 1 )) || return 0
    [[ $(apo_state_get STATUS '') == PASS && $(apo_state_get PHASE '') == COMPLETE ]] || return 0
    apo_apply_recommendation
    if [[ $(apo_state_get APPLY_STATUS '') == APPLIED && $(apo_state_get OVERCLOCK_COMPLETE_RECORDED 0) != 1 ]]; then
        apo_summary_line 'OVERCLOCK COMPLETE: the validated clocks were applied and verified after reboot.'
        apo_event overclock PASS '' 'Automatic tuning, final validation, permanent application, and post-reboot verification completed.'
        apo_state_set OVERCLOCK_COMPLETE_RECORDED 1
        apo_state_save
    fi
}

