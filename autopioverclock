    if (( APO_MANUAL_TEST == 1 )); then
        apo_summary_line "Manual stability target: CPU $APO_MANUAL_CPU MHz / GPU $APO_MANUAL_GPU MHz"
        apo_summary_line "Manual timed stress: $APO_MANUAL_MINUTES minutes ($APO_MANUAL_DURATION_S seconds)"
        apo_summary_line 'Manual test result: evidence only; never a validated recommendation or permanent apply input'
    fi
    if (( APO_AUTO_GENERATED_CANDIDATES == 1 )); then
        apo_summary_line "Automatic refinement: ${APO_AUTO_REFINE_STEP_MHZ}MHz"
        apo_summary_line "Automatic production guard: CPU ${APO_AUTO_CPU_GUARD_MHZ}MHz / GPU ${APO_AUTO_GPU_GUARD_MHZ}MHz"
        apo_summary_line "Optional post-floor CPU +25MHz/24-hour validation: $([[ $APO_EDGE_CPU_24H == 1 ]] && printf enabled || printf disabled)"
    fi
    apo_summary_line ''
    apo_event run-start INFO '' "command=$APO_ORIGIN_COMMAND version=$APO_VERSION"

    apo_prepare_target
    APO_HAVE_REMOTE_CONTEXT=1
    if [[ $APO_COMMAND == prepare ]]; then
        if apo_config_stock_auto_baseline_ready "$APO_NORMAL_CPU" "$APO_NORMAL_GPU" "$APO_NORMAL_VOLTAGE" \
            "$APO_PERMANENT_TUNING_PROVENANCE" "$APO_PERMANENT_TUNING_EVIDENCE"; then
            apo_state_phase COMPLETE HOST_READY PASS
            apo_summary_line "HOST READY: profile=$APO_PROFILE mode=$APO_MODE_EFFECTIVE normal=${APO_NORMAL_CPU}/${APO_NORMAL_GPU} voltage=${APO_NORMAL_VOLTAGE}"
            apo_summary_line "Next: autopioverclock overclock $APO_RAW_TARGET"
