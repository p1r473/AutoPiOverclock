apo_start_post_floor_edge() {
    local source_state_file=$APO_POST_FLOOR_EDGE_SOURCE_STATE source_run_id source_hash floor_cpu floor_gpu edge_target
    local validation_reason source_mode source_gpu_requirement key cpu_boundary baseline_boot_id
    local -A source_state=()
    [[ -n $source_state_file && -f $source_state_file ]] ||
        apo_die 'The retained production-floor state selected for the edge run is unavailable.' "$APO_EXIT_USAGE"
    apo_state_load "$source_state_file"
    [[ $(apo_state_get REMOTE_TARGET '') == "$APO_REMOTE_TARGET" ]] ||
        apo_die 'The retained production-floor state belongs to another target.' "$APO_EXIT_USAGE"
    apo_post_floor_edge_source_is_eligible ||
        apo_die 'The retained run is not an applied current-schema automatic floor with clear tryboot ownership.' "$APO_EXIT_USAGE"
    source_run_id=$(apo_state_get RUN_ID '')
    source_hash=$(apo_state_get PERMANENT_HASH '')
    floor_cpu=$(apo_state_get FINAL_CPU '')
    floor_gpu=$(apo_state_get FINAL_GPU '')
    source_mode=$(apo_state_get MODE_EFFECTIVE '')
    source_gpu_requirement=$(apo_state_get REQUIRE_GPU_STRESS '')
    APO_RUN_ID=$source_run_id
    apo_restore_context_from_state
    if [[ $(apo_state_get RUN_SCHEMA '') == 9 ]]; then
        apo_config_migrate_duration_schema_9 ||
            apo_die 'The retained floor could not be upgraded to the duration-aware run schema.' "$APO_EXIT_HARNESS"
    fi
    APO_STATE_VALIDATION_READ_ONLY=1
    if ! apo_validate_auto_resume_state; then
        validation_reason=${APO_LAST_REASON:-'retained state validation failed'}
        APO_STATE_VALIDATION_READ_ONLY=0
        APO_STATE=()
        APO_STATE_FILE=''
        apo_die "The retained floor failed read-only safety validation: $validation_reason" "$APO_EXIT_HARNESS"
    fi
    APO_STATE_VALIDATION_READ_ONLY=0
    [[ $APO_MODE_EFFECTIVE == "$source_mode" && $APO_REQUIRE_GPU_STRESS == "$source_gpu_requirement" ]] ||
        apo_die 'The retained graphical/headless validation mode could not be reconstructed exactly.' "$APO_EXIT_HARNESS"
    for key in "${!APO_STATE[@]}"; do source_state["$key"]=${APO_STATE[$key]}; done

    APO_EDGE_CPU_24H=1
    APO_MAX_FAN=$APO_POST_FLOOR_EDGE_MAX_FAN
    APO_EDGE_DURATION_S=$APO_POST_FLOOR_EDGE_DURATION_S
    APO_DURATION_POLICY=$(apo_config_duration_policy "$APO_QUALIFICATION_DURATION_S" "$APO_FINAL_DURATION_S" "$APO_EDGE_DURATION_S")
    edge_target=$((floor_cpu + APO_AUTO_REFINE_STEP_MHZ))
    apo_init_artifacts
    APO_STATE=()
    for key in "${!source_state[@]}"; do APO_STATE["$key"]=${source_state[$key]}; done
    apo_post_floor_edge_reset_child_state "$source_run_id" "$source_hash" "$floor_cpu" "$floor_gpu" "$edge_target"
    apo_progress_start_session
    apo_load_profile "$APO_PROFILE"
    apo_store_artifact_state
    apo_write_effective_config "$APO_EFFECTIVE_CONFIG_FILE"
    {
        printf 'SourceFloorRunID=%s\nSourceFloorState=%s\nSourceFloorPermanentHash=%s\n' \
            "$source_run_id" "$source_state_file" "$source_hash"
        printf 'Profile=%s\nMode=%s\nGPUStressRequired=%s\nFloorCPU=%s\nFloorGPU=%s\nEdgeCPU=%s\n' \
            "$APO_PROFILE" "$APO_MODE_EFFECTIVE" "$APO_REQUIRE_GPU_STRESS" "$floor_cpu" "$floor_gpu" "$edge_target"
    } > "$APO_DISCOVERY_FILE"
    chmod 600 "$APO_DISCOVERY_FILE"
    apo_summary_line "AutoPiOverclock post-floor CPU edge validation"
    apo_summary_line "Run ID: $APO_RUN_ID"
    apo_summary_line "Source validated floor run: $source_run_id"
    apo_summary_line "Target: $APO_REMOTE_TARGET"
    apo_summary_line "Retained mode: $APO_MODE_EFFECTIVE"
    apo_summary_line "Applied production floor: CPU $floor_cpu MHz / GPU $floor_gpu MHz"
    apo_summary_line "Edge target: CPU $edge_target MHz / GPU $floor_gpu MHz for ${APO_EDGE_DURATION_S}s"
    apo_summary_line "Maximum fan cooling during tuning: $([[ $APO_MAX_FAN == 1 ]] && printf enabled || printf disabled)"
    apo_summary_line "The retained ${APO_FINAL_DURATION_S}s final endurance phase will not be repeated."
    apo_summary_line ''
    apo_event run-start INFO '' "command=overclock-post-floor-edge version=$APO_VERSION source-run=$source_run_id mode=$APO_MODE_EFFECTIVE"

    apo_validate_auto_resume_state || return "$APO_EXIT_HARNESS"
    apo_prepare_remote_for_saved_run
    if ! apo_apply_assert_tryboot_clear; then
        apo_state_fail RECOVERY_FAILURE "Post-floor edge baseline has uncleared tryboot evidence: $APO_LAST_REASON"
        return "$APO_EXIT_RECOVERY"
    fi
    if ! apo_verify_permanent_hash post-floor-edge-baseline-hash; then
        apo_state_fail RECOVERY_FAILURE "The applied production-floor config no longer matches source run $source_run_id: $APO_LAST_REASON"
        return "$APO_EXIT_RECOVERY"
    fi
    if ! apo_recover_normal post-floor-edge-baseline-health; then
        apo_state_fail RECOVERY_FAILURE "The applied production floor did not pass current normal-health proof: $APO_LAST_REASON"
        return "$APO_EXIT_RECOVERY"
    fi
    baseline_boot_id=$(apo_state_get NORMAL_BOOT_ID '')
    apo_state_set BASELINE_BOOT_ID "$baseline_boot_id"
    apo_state_set SUBPHASE EDGE_CPU_24H_PRE_STRESS_BOOT
    apo_state_save

    cpu_boundary=$(apo_state_get CPU_FAILURE_BOUNDARY '')
    if (( edge_target > APO_AUTO_CPU_MAX_MHZ )) ||
       { [[ -n $cpu_boundary ]] && (( edge_target >= cpu_boundary )); }; then
        apo_state_set EDGE_CPU_STATUS SKIPPED_KNOWN_BOUNDARY
        apo_state_set RECOMMENDED_CPU "$floor_cpu"
        apo_state_set RECOMMENDED_GPU "$floor_gpu"
        apo_state_set FINAL_TARGET_CPU "$floor_cpu"
        apo_state_set FINAL_TARGET_GPU "$floor_gpu"
        apo_state_complete "$floor_cpu" "$floor_gpu" "$APO_FINAL_DURATION_S"
        apo_summary_line "OPTIONAL EDGE CPU: SKIPPED — ${edge_target} MHz meets or exceeds the retained failure/ceiling boundary; kept the applied production floor."
        apo_event edge-cpu-24h WARN STABILITY_FAILURE "Skipped known unsafe edge CPU target $edge_target MHz; retained applied floor CPU=$floor_cpu GPU=$floor_gpu"
        return 0
    fi
    apo_event post-floor-edge PASS '' "Applied ${APO_FINAL_DURATION_S}s floor and headless/graphical mode were re-proved; starting only the CPU +25 MHz/${APO_EDGE_DURATION_S}s edge validation."
    apo_final_validation
}

apo_resume_post_floor_final() {
    local extension_stage apply_status source_run_id source_hash source_duration source_backup old_hash
    local final_cpu final_gpu status saved_failure_stage saved_failure_class saved_failure_reason normal_recovery_done=0
    [[ $(apo_state_get POST_FLOOR_FINAL 0) == 1 ]] ||
        apo_die 'Internal error: longer final-validation continuation lacks its source marker.' "$APO_EXIT_INTERNAL"
    source_run_id=$(apo_state_get SOURCE_FINAL_RUN_ID '')
    source_hash=$(apo_state_get SOURCE_FINAL_PERMANENT_HASH '')
    source_duration=$(apo_state_get SOURCE_FINAL_VALIDATION_DURATION_S '')
    source_backup=$(apo_state_get SOURCE_FINAL_APPLY_BACKUP '')
    final_cpu=$(apo_state_get FINAL_TARGET_CPU "$(apo_state_get FINAL_CPU '')")
    final_gpu=$(apo_state_get FINAL_TARGET_GPU "$(apo_state_get FINAL_GPU '')")
    [[ $(apo_state_get RUN_SCHEMA '') == "$APO_CURRENT_RUN_SCHEMA" &&
       $source_run_id != "$(apo_state_get RUN_ID '')" ]] && apo_is_safe_run_id "$source_run_id" &&
       [[ $source_hash =~ ^[0-9a-f]{64}$ && $source_duration =~ ^[1-9][0-9]{0,6}$ &&
          -n $source_backup && $final_cpu =~ ^[0-9]+$ && $final_gpu =~ ^[0-9]+$ ]] ||
        apo_die 'The longer final-validation continuation has malformed source identity or clock evidence.' "$APO_EXIT_HARNESS"

    extension_stage=$(apo_state_get POST_FLOOR_FINAL_STAGE '')
    if [[ $extension_stage == ROLLBACK_PENDING ]]; then
        apo_prepare_remote_for_saved_run
        apply_status=$(apo_state_get APPLY_STATUS '')
        case $apply_status in
            APPLIED)
                apo_apply_assert_tryboot_clear || {
                    apo_state_fail RECOVERY_FAILURE "Longer final validation found uncleared tryboot evidence before stock rollback: $APO_LAST_REASON"
                    return "$APO_EXIT_RECOVERY"
                }
                [[ $(apo_state_get PERMANENT_HASH '') == "$source_hash" ]] || {
                    apo_state_fail RECOVERY_FAILURE 'The applied config hash in the continuation state no longer matches its source result.'
                    return "$APO_EXIT_RECOVERY"
                }
                apo_verify_permanent_hash post-floor-final-applied-baseline || {
                    apo_state_fail RECOVERY_FAILURE "The applied result changed before longer final validation: $APO_LAST_REASON"
                    return "$APO_EXIT_RECOVERY"
                }
                apo_recover_normal post-floor-final-applied-health || {
                    apo_state_fail RECOVERY_FAILURE "The applied result did not pass current health before stock rollback: $APO_LAST_REASON"
                    return "$APO_EXIT_RECOVERY"
                }
                APO_NORMAL_CPU=$APO_AUTO_BASELINE_CPU
                APO_NORMAL_GPU=$APO_AUTO_BASELINE_GPU
                APO_NORMAL_VOLTAGE=$APO_AUTO_BASELINE_VOLTAGE
                apo_state_set NORMAL_CPU "$APO_NORMAL_CPU"
                apo_state_set NORMAL_GPU "$APO_NORMAL_GPU"
                apo_state_set NORMAL_VOLTAGE "$APO_NORMAL_VOLTAGE"
                old_hash=$(apo_state_get APPLY_OLD_HASH '')
                apo_apply_restore_old_config "$old_hash" "$source_backup" \
                    "Preparing a stock recovery baseline before extending source run $source_run_id from ${source_duration}s to ${APO_FINAL_DURATION_S}s" ||
                    return "$APO_EXIT_APPLY"
                ;;
            APPLYING)
                APO_NORMAL_CPU=$APO_AUTO_BASELINE_CPU
                APO_NORMAL_GPU=$APO_AUTO_BASELINE_GPU
                APO_NORMAL_VOLTAGE=$APO_AUTO_BASELINE_VOLTAGE
                apo_state_set NORMAL_CPU "$APO_NORMAL_CPU"
                apo_state_set NORMAL_GPU "$APO_NORMAL_GPU"
                apo_state_set NORMAL_VOLTAGE "$APO_NORMAL_VOLTAGE"
                apo_reconcile_interrupted_apply || return "$APO_EXIT_APPLY"
                ;;
            ROLLED_BACK) ;;
            FAILED_NEEDS_MANUAL_RECOVERY)
                apo_die "The stock rollback for longer final validation needs manual recovery: $(apo_state_get APPLY_FAILURE_REASON 'unknown mismatch')" "$APO_EXIT_APPLY"
                ;;
            *)
                apo_die "Longer final validation found an unexpected rollback state: ${apply_status:-missing}." "$APO_EXIT_HARNESS"
                ;;
        esac
        [[ $(apo_state_get APPLY_STATUS '') == ROLLED_BACK ]] ||
            apo_die 'The verified pre-apply stock config was not restored; longer final validation is refusing to start.' "$APO_EXIT_APPLY"
        apo_state_set POST_FLOOR_FINAL_STAGE ROLLBACK_COMPLETE
        apo_state_set SUBPHASE POST_FLOOR_FINAL_ROLLBACK_COMPLETE
        apo_state_save
        extension_stage=ROLLBACK_COMPLETE
    fi

    if [[ $extension_stage == ROLLBACK_COMPLETE ]]; then
        apo_post_floor_final_normalize_after_rollback "$final_cpu" "$final_gpu" ||
            return "$APO_EXIT_APPLY"
        extension_stage=VALIDATING
        apo_summary_line "STOCK BASELINE RESTORED: the source result is no longer permanent while its longer validation runs."
        apo_event post-floor-final-rollback PASS '' "Verified stock config restored; starting ${APO_FINAL_DURATION_S}s validation of CPU=$final_cpu GPU=$final_gpu."
    fi

    [[ $extension_stage == VALIDATING || $extension_stage == BACKOFF_TUNING || $extension_stage == COMPLETE || $extension_stage == FAILED ]] ||
        apo_die "Unknown longer final-validation stage: ${extension_stage:-missing}." "$APO_EXIT_HARNESS"
    apo_validate_auto_resume_state || return "$APO_EXIT_HARNESS"
    if [[ $(apo_state_get APPLY_STATUS NOT_APPLIED) == APPLYING ]]; then
        apo_prepare_remote_for_saved_run
        apo_reconcile_interrupted_apply || return "$APO_EXIT_APPLY"
    fi
    status=$(apo_state_get STATUS '')
    if [[ $status == PASS && $(apo_state_get PHASE '') == COMPLETE ]]; then
        apo_finish_public_overclock
        if [[ $(apo_state_get APPLY_STATUS '') == APPLIED || $APO_AUTO_APPLY == 0 ]]; then
            apo_state_set POST_FLOOR_FINAL_STAGE COMPLETE
            apo_state_save
        fi
        return 0
    fi
    if [[ $status == FAILED ]]; then
        saved_failure_stage=$(apo_state_get FINAL_STAGE '')
        saved_failure_class=$(apo_state_get FAILURE_CLASS HARNESS_FAILURE)
        saved_failure_reason=$(apo_state_get FAILURE_REASON '')
        if ! apo_final_saved_failure_is_retryable "$APO_CURRENT_RUN_SCHEMA"; then
            return "$(apo_class_exit_code "$saved_failure_class")"
        fi
        apo_prepare_remote_for_saved_run
        apo_recover_normal post-floor-final-backoff-recovery || {
            apo_state_fail RECOVERY_FAILURE "$APO_LAST_REASON"
            apo_state_set POST_FLOOR_FINAL_STAGE FAILED
            apo_state_save
            return "$APO_EXIT_RECOVERY"
        }
        normal_recovery_done=1
        if ! apo_post_floor_final_schedule_stress_backoff "$saved_failure_stage" "$saved_failure_class" "$saved_failure_reason"; then
            return "$(apo_class_exit_code "$saved_failure_class")"
        fi
        extension_stage=BACKOFF_TUNING
        status=RUNNING
    fi
    if (( normal_recovery_done == 0 )); then
        apo_prepare_remote_for_saved_run
        apo_recover_normal post-floor-final-resume-recovery || {
            apo_state_fail RECOVERY_FAILURE "$APO_LAST_REASON"
            apo_state_set POST_FLOOR_FINAL_STAGE FAILED
            apo_state_save
            return "$APO_EXIT_RECOVERY"
        }
        apo_state_set STATUS RUNNING
        apo_state_set FAILURE_CLASS ''
        apo_state_set FAILURE_REASON ''
        apo_state_save
    fi
    if ! apo_run_tuning; then
        apo_state_set POST_FLOOR_FINAL_STAGE FAILED
        apo_state_save
        return "$(apo_class_exit_code "$(apo_state_get FAILURE_CLASS HARNESS_FAILURE)")"
    fi
    apo_finish_public_overclock
    if [[ $(apo_state_get APPLY_STATUS '') == APPLIED || $APO_AUTO_APPLY == 0 ]]; then
        apo_state_set POST_FLOOR_FINAL_STAGE COMPLETE
        apo_state_save
    fi
}

apo_start_post_floor_final() {
