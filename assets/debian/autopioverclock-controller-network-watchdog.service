# AUTOPIOVERCLOCK MANAGED CONTROLLER NETWORK WATCHDOG
[Unit]
Description=AutoPiOverclock controller network-loss reboot companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/autopioverclock/controller-network-watchdog-keeper.py /var/lib/autopioverclock/controller-network-watchdog/watchdog.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
